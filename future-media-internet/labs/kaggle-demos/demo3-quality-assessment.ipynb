   "source": [
    "# 实验三（课堂演示）：AI 驱动的视频质量评估\n",
    "\n",
    "**适用课程**：未来媒体互联网  \n",
    "**演示时长**：约 10 分钟  \n",
    "**运行环境**：Kaggle Notebook（PyTorch 预装）\n",
    "\n",
    "## 演示目标\n",
    "\n",
    "让学生看到：传统指标（PSNR）和 AI 感知指标（SSIM）评判同一张图的结论可能相反。\n",
    "理解为什么 Netflix/YouTube 用 AI 指标而非 PSNR 来优化编码。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from PIL import Image\n",
    "import requests\n",
    "from io import BytesIO\n",
    "import torch\n",
    "import torch.nn.functional as F\n",
    "\n",
    "print(\"环境就绪 ✅\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 用内置图案模拟\"原始图 vs 压缩图\"的对比\n",
    "# 真实场景中需准备视频帧，这里用合成图演示原理\n",
    "\n",
    "def create_test_image():\n",
    "    \"\"\"创建包含细节的测试图：文字 + 渐变 + 边缘\"\"\"\n",
    "    img = np.ones((256, 256), dtype=np.float32) * 0.5\n",
    "    # 白色方块（模拟文字）\n",
    "    img[60:100, 40:200] = 0.9\n",
    "    img[120:160, 40:200] = 0.9\n",
    "    # 渐变背景\n",
    "    for i in range(256):\n",
    "        img[i, 210:256] = i / 256\n",
    "    # 细线（高频细节）\n",
    "    for j in range(180, 190):\n",
    "        img[:, j] = 1.0\n",
    "    return img\n",
    "\n",
    "def degrade_quality(img, level):\n",
    "    \"\"\"模拟不同程度的压缩失真\"\"\"\n",
    "    # level 0=无损, 1=轻微, 2=中等, 3=严重\n",
    "    noise_levels = [0.0, 0.03, 0.1, 0.25]\n",
    "    blur_levels = [0, 1, 3, 7]\n",
    "    \n",
    "    degraded = img.copy()\n",
    "    # 加噪\n",
    "    noise = np.random.randn(*img.shape) * noise_levels[level]\n",
    "    degraded = degraded + noise\n",
    "    # 模拟块效应（JPEG 风格失真）\n",
    "    if level >= 2:\n",
    "        block_size = 8 if level == 2 else 16\n",
    "        for i in range(0, 256, block_size):\n",
    "            for j in range(0, 256, block_size):\n",
    "                degraded[i:i+block_size, j:j+block_size] = degraded[i:i+block_size, j:j+block_size].mean()\n",
    "    degraded = np.clip(degraded, 0, 1)\n",
    "    return degraded\n",
    "\n",
    "original = create_test_image()\n",
    "versions = [degrade_quality(original, lv) for lv in range(4)]\n",
    "\n",
    "fig, axes = plt.subplots(1, 4, figsize=(16, 5))\n",
    "titles = ['原始', '轻微压缩', '中等压缩', '严重压缩']\n",
    "for i, (ax, img, title) in enumerate(zip(axes, versions, titles)):\n",
    "    ax.imshow(img, cmap='gray', vmin=0, vmax=1)\n",
    "    ax.set_title(title)\n",
    "    ax.axis('off')\n",
    "plt.suptitle('模拟不同压缩程度的图像')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 计算三种质量指标\n",
    "def psnr(original, degraded):\n",
    "    mse = np.mean((original - degraded) ** 2)\n",
    "    if mse == 0:\n",
    "        return 100\n",
    "    return 20 * np.log10(1.0 / np.sqrt(mse))\n",
    "\n",
    "def ssim_torch(original, degraded):\n",
    "    \"\"\"简化版 SSIM，基于 PyTorch\"\"\"\n",
    "    orig_t = torch.tensor(original).unsqueeze(0).unsqueeze(0).float()\n",
    "    deg_t = torch.tensor(degraded).unsqueeze(0).unsqueeze(0).float()\n",
    "    \n",
    "    # 均值\n",
    "    mu_x = F.avg_pool2d(orig_t, 11, 1, 5)\n",
    "    mu_y = F.avg_pool2d(deg_t, 11, 1, 5)\n",
    "    \n",
    "    # 方差和协方差\n",
    "    sigma_x = F.avg_pool2d(orig_t ** 2, 11, 1, 5) - mu_x ** 2\n",
    "    sigma_y = F.avg_pool2d(deg_t ** 2, 11, 1, 5) - mu_y ** 2\n",
    "    sigma_xy = F.avg_pool2d(orig_t * deg_t, 11, 1, 5) - mu_x * mu_y\n",
    "    \n",
    "    C1, C2 = 0.01 ** 2, 0.03 ** 2\n",
    "    ssim_map = ((2 * mu_x * mu_y + C1) * (2 * sigma_xy + C2)) / \\\n",
    "               ((mu_x ** 2 + mu_y ** 2 + C1) * (sigma_x + sigma_y + C2))\n",
    "    return ssim_map.mean().item()\n",
    "\n",
    "# 计算所有版本\n",
    "results = []\n",
    "for i, (ver, name) in enumerate(zip(versions, titles)):\n",
    "    p = psnr(original, ver)\n",
    "    s = ssim_torch(original, ver)\n",
    "    results.append({'name': name, 'PSNR': p, 'SSIM': s})\n",
    "    print(f\"{name:8s} | PSNR: {p:5.1f} dB | SSIM: {s:.3f}\")\n",
    "\n",
    "print(\"\\n观察重点：\")\n",
    "print(\"PSNR 是纯数学指标（像素差），SSIM 模拟人眼感知（关注结构和纹理）\")\n",
    "print(\"当 PSNR 相近时，SSIM 可能差异很大——因为人眼对结构失真更敏感\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 可视化对比\n",
    "names = [r['name'] for r in results]\n",
    "psnrs = [r['PSNR'] for r in results]\n",
    "ssims = [r['SSIM'] for r in results]\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "colors = ['#2ecc71', '#f39c12', '#e67e22', '#e74c3c']\n",
    "ax1.bar(names, psnrs, color=colors)\n",
    "ax1.set_ylabel('PSNR (dB)')\n",
    "ax1.set_title('传统指标：PSNR（越高越好）')\n",
    "for i, v in enumerate(psnrs):\n",
    "    ax1.text(i, v + 0.5, f'{v:.1f}', ha='center', fontweight='bold')\n",
    "\n",
    "ax2.bar(names, ssims, color=colors)\n",
    "ax2.set_ylabel('SSIM')\n",
    "ax2.set_title('感知指标：SSIM（越接近 1 越好）')\n",
    "for i, v in enumerate(ssims):\n",
    "    ax2.text(i, v + 0.02, f'{v:.3f}', ha='center', fontweight='bold')\n",
    "\n",
    "plt.suptitle('传统指标 vs 感知指标：同一组图的两种评价', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n课堂互动问题：\")\n",
    "print(\"1. PSNR 高但看起来差的情况在什么场景最常见？（提示：图像有纹理的区域）\")\n",
    "print(\"2. 为什么 YouTube 不用 PSNR 来决定编码参数？\")\n",
    "print(\"3. AI 质量评估模型（如 LPIPS）比 SSIM 好在哪？（提示：用神经网络学习\\\"人觉得好不好看\\\"）\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 课堂演示流程（10 分钟）\n",
    "\n",
    "1. **0-2 min**：展示不同压缩程度的四张图，让学生\\"肉眼打分\\"\n",
    "2. **2-5 min**：计算 PSNR 和 SSIM，展示数值和柱状图\n",
    "3. **5-8 min**：对比两种指标的差异，解释\\"PSNR 的局限性\\"\n",
    "4. **8-10 min**：交代完整版实验用 LPIPS（AI 模型）做更精准的感知评估\n",
    "\n",
    "## 课后延伸\n",
    "\n",
    "完整版实验使用真实视频帧 + LPIPS/DISTS 模型，学生对比 PSNR/SSIM/LPIPS 三者在同一组视频上的评分一致性。"
   ]
  }
