   "source": [
    "# 实验四（课堂演示）：神经图像压缩 vs JPEG\n",
    "\n",
    "**适用课程**：未来媒体互联网  \n",
    "**演示时长**：约 10 分钟  \n",
    "**运行环境**：Kaggle Notebook（PyTorch 预装）\n",
    "\n",
    "## 演示目标\n",
    "\n",
    "让学生直观对比 JPEG 和神经压缩两种编码方式的差异：\n",
    "- JPEG：基于 DCT 变换，固定算法，会产生方块效应\n",
    "- 神经压缩：端到端训练的神经网络，自适应学习压缩策略\n",
    "\n",
    "核心展示：相近压缩比下，JPEG 的方块效应 vs 神经压缩的平滑重建。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from PIL import Image\n",
    "import io\n",
    "\n",
    "print(\"PyTorch 已就绪 ✅\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 生成演示用测试图像：包含高频和低频区域\n",
    "def create_demo_image(size=128):\n",
    "    img = np.zeros((size, size), dtype=np.float32)\n",
    "    # 棋盘格（高频）\n",
    "    for i in range(0, size, 8):\n",
    "        for j in range(0, size, 8):\n",
    "            if (i//8 + j//8) % 2 == 0:\n",
    "                img[i:i+8, j:j+8] = 0.9\n",
    "            else:\n",
    "                img[i:i+8, j:j+8] = 0.1\n",
    "    # 平滑渐变（低频）\n",
    "    for i in range(20, 60):\n",
    "        img[i+60, 20:100] = 0.3 + (i-20)/40 * 0.6\n",
    "    # 细线\n",
    "    img[100:110, :] = 1.0\n",
    "    return img\n",
    "\n",
    "original = create_demo_image(128)\n",
    "\n",
    "plt.figure(figsize=(4, 4))\n",
    "plt.imshow(original, cmap='gray', vmin=0, vmax=1)\n",
    "plt.title('原始测试图像\\n（棋盘格=高频 | 渐变=低频 | 横线=边缘）')\n",
    "plt.axis('off')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 简单的神经自编码器（卷积版本）\n",
    "class ConvAutoencoder(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        # 编码器：压缩到 1/4 尺寸\n",
    "        self.encoder = nn.Sequential(\n",
    "            nn.Conv2d(1, 16, 3, stride=2, padding=1), nn.ReLU(),\n",
    "            nn.Conv2d(16, 32, 3, stride=2, padding=1), nn.ReLU(),\n",
    "            nn.Conv2d(32, 8, 3, stride=2, padding=1), nn.ReLU(),\n",
    "        )\n",
    "        # 解码器：恢复到原始尺寸\n",
    "        self.decoder = nn.Sequential(\n",
    "            nn.ConvTranspose2d(8, 32, 3, stride=2, padding=1, output_padding=1), nn.ReLU(),\n",
    "            nn.ConvTranspose2d(32, 16, 3, stride=2, padding=1, output_padding=1), nn.ReLU(),\n",
    "            nn.ConvTranspose2d(16, 1, 3, stride=2, padding=1, output_padding=1), nn.Sigmoid(),\n",
    "        )\n",
    "    \n",
    "    def forward(self, x):\n",
    "        return self.decoder(self.encoder(x))\n",
    "\n",
    "# 创建并训练一个小模型来演示概念（实际用预训练模型更快）\n",
    "# 这里用简单方式演示：用不同程度的降采样来模拟\"神经压缩\"\n",
    "# 这样无需训练，直接展示概念\n",
    "\n",
    "def neural_compress_simple(img_tensor, compression_level):\n",
    "    \"\"\"\n",
    "    简化模拟神经压缩：通过降采样+上采样模拟\n",
    "    实际神经压缩比这复杂得多，但视觉效果类似\n",
    "    \"\"\"\n",
    "    factors = [1, 2, 4, 8]\n",
    "    factor = factors[min(compression_level, 3)]\n",
    "    if factor == 1:\n",
    "        return img_tensor.clone()\n",
    "    \n",
    "    _, _, h, w = img_tensor.shape\n",
    "    # 降采样\n",
    "    small = F.interpolate(img_tensor, size=(h//factor, w//factor), mode='area')\n",
    "    # 上采样\n",
    "    restored = F.interpolate(small, size=(h, w), mode='bilinear', align_corners=False)\n",
    "    return restored\n",
    "\n",
    "print(\"神经压缩模拟器就绪 ✅\")\n",
    "print(\"注：实际神经压缩用端到端训练的网络，这里用采样模拟原理展示\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# JPEG 模拟（量化造成的方块效应）\n",
    "def jpeg_simulate(img_tensor, quality):\n",
    "    \"\"\"\n",
    "    模拟 JPEG 压缩效果：\n",
    "    - 对 8x8 块做平均（模拟量化）\n",
    "    - quality 越低，块越大\n",
    "    \"\"\"\n",
    "    block_sizes = [1, 4, 8, 16]\n",
    "    block = block_sizes[min(quality, 3)]\n",
    "    if block == 1:\n",
    "        return img_tensor.clone()\n",
    "    \n",
    "    result = img_tensor.clone()\n",
    "    _, _, h, w = result.shape\n",
    "    for i in range(0, h, block):\n",
    "        for j in range(0, w, block):\n",
    "            i_end = min(i + block, h)\n",
    "            j_end = min(j + block, w)\n",
    "            result[:, :, i:i_end, j:j_end] = result[:, :, i:i_end, j:j_end].mean()\n",
    "    return result\n",
    "\n",
    "print(\"JPEG 模拟器就绪 ✅\")\n",
    "print(\"注：真实 JPEG 的块效应来自 8x8 DCT 量化，这里用块平均近似展示\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 构建对比矩阵\n",
    "img_t = torch.tensor(original).unsqueeze(0).unsqueeze(0).float()\n",
    "\n",
    "levels = {'无损': 0, '轻度': 1, '中度': 2, '重度': 3}\n",
    "\n",
    "fig, axes = plt.subplots(2, 4, figsize=(16, 8))\n",
    "\n",
    "for j, (label, lv) in enumerate(levels.items()):\n",
    "    # JPEG 模拟\n",
    "    jpeg_result = jpeg_simulate(img_t, lv)\n",
    "    axes[0, j].imshow(jpeg_result.squeeze(), cmap='gray', vmin=0, vmax=1)\n",
    "    axes[0, j].set_title(f'JPEG 模拟\\n{label}压缩', fontsize=11)\n",
    "    axes[0, j].axis('off')\n",
    "    \n",
    "    # 神经压缩模拟\n",
    "    neural_result = neural_compress_simple(img_t, lv)\n",
    "    axes[1, j].imshow(neural_result.squeeze(), cmap='gray', vmin=0, vmax=1)\n",
    "    axes[1, j].set_title(f'神经压缩\\n{label}压缩', fontsize=11)\n",
    "    axes[1, j].axis('off')\n",
    "\n",
    "plt.suptitle('JPEG vs 神经压缩：同一图像在不同压缩程度下的对比\\n（上排：JPEG | 下排：神经压缩）',\n",
    "             fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n观察重点：\")\n",
    "print(\"1. JPEG：中度以上出现明显方块（8x8 块边界），高频棋盘格完全丢失\")\n",
    "print(\"2. 神经压缩：压缩后保留整体结构，但细节变模糊（降采样→上采样的平滑效果）\")\n",
    "print(\"3. 真实神经压缩使用端到端训练的 CNN/Transformer，比这里的模拟效果好得多\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 课堂演示流程（10 分钟）\n",
    "\n",
    "1. **0-2 min**：展示原始图像，强调\\"棋盘格=高频细节，渐变=低频平滑\\"\n",
    "2. **2-5 min**：逐列对比 JPEG 和神经压缩，从无损到重度\n",
    "3. **5-8 min**：聚焦\\"中度压缩\\"列——JPEG 大方块 vs 神经压缩的模糊但连贯\n",
    "4. **8-10 min**：讨论\\"为什么深度学习能做得更好\\"——自适应学习 vs 固定算法\n",
    "\n",
    "## 课后延伸\n",
    "\n",
    "完整版实验使用 CompressAI 预训练模型，在真实照片上对比 JPEG 和神经压缩的率失真曲线。"
   ]
  }
